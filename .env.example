# Copy to .env (repository root) and replace every placeholder. Never commit the real file.
# --- RabbitMQ broker ---
# Layer 1 (stellartrackbackend), Layer 2 and Layer 3 publish to the topic exchange "stellar-track-exchange" on the
# DEFAULT vhost "/" as guest/guest. Phase 2 must connect to that SAME broker and vhost or it receives nothing.
# Either point ST_RABBITMQ_* at the broker the layers already use (and do not start the compose "rabbitmq" service),
# or start the compose broker below and point the layers at it. guest/guest is for local development only.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
ST_RABBITMQ_HOST=localhost
ST_RABBITMQ_PORT=5672
ST_RABBITMQ_USERNAME=guest
ST_RABBITMQ_PASSWORD=guest
ST_RABBITMQ_VHOST=/
ST_RABBITMQ_SSL_ENABLED=false

# Layer subscriptions (see docs/integrations/rabbitmq-contracts.md). Phase 2 declares its OWN durable queues and binds
# them to the layers' exchange; it never consumes layer1-predictions-queue, planetary-state-queue, race-data-queue or
# race-results-queue (that would steal Layer 2/3's messages). The "local" profile already defaults to these values.
ST_LAYER1_ENABLED=true
ST_LAYER1_QUEUE=stellartrack.phase2.layer1
ST_LAYER1_EXCHANGE=stellar-track-exchange
# layer1-predictions-queue is the routing key the race-hit-service replay tool uses when it publishes directly.
ST_LAYER1_ROUTING_KEYS=layer1.prediction,layer1-predictions-queue
ST_LAYER1_DECLARE_SUBSCRIPTION=true
ST_LAYER1_REJECT_STALE=false
ST_LAYER2_ENABLED=true
ST_LAYER2_QUEUE=stellartrack.phase2.layer2
ST_LAYER2_EXCHANGE=stellar-track-exchange
ST_LAYER2_ROUTING_KEYS=state-change
ST_LAYER2_DECLARE_SUBSCRIPTION=true
ST_LAYER2_REJECT_STALE=false
ST_LAYER3_ENABLED=true
ST_LAYER3_QUEUE=stellartrack.phase2.layer3
ST_LAYER3_EXCHANGE=stellar-track-exchange
ST_LAYER3_ROUTING_KEYS=layer3.reranked
ST_LAYER3_DECLARE_SUBSCRIPTION=true
ST_LAYER3_REJECT_STALE=false

# --- Application authentication (JWT) ---
# At least 32 random bytes, base64 encoded. Generate with: openssl rand -base64 48
ST_JWT_SECRET=<base64-secret>
ST_JWT_ISSUER=stellar-track
ST_JWT_AUDIENCE=stellar-track-web
ST_JWT_ACCESS_TTL=PT10M
ST_JWT_REFRESH_TTL=PT12H
ST_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Betfair (secure backend configuration only) ---
ST_BETFAIR_ENABLED=false
ST_BETFAIR_APP_KEY=<betfair-application-key>
ST_BETFAIR_USERNAME=<betfair-username>
ST_BETFAIR_PASSWORD=<betfair-password>
# Keystore path for a backend run outside Docker (IDE / java -jar). The local profile loads this file automatically.
ST_BETFAIR_CERT_KEYSTORE=<absolute-path-to>/client.p12
# Docker Compose mounts ST_BETFAIR_CERT_DIR read-only and reads ST_BETFAIR_CERT_FILE from it.
ST_BETFAIR_CERT_DIR=./certificate
ST_BETFAIR_CERT_FILE=client.p12
ST_BETFAIR_CERT_KEYSTORE_PASSWORD=<keystore-password>
ST_BETFAIR_STREAM_ENABLED=false

# --- Replay storage ---
ST_REPLAY_STORAGE_DIR=/var/lib/stellartrack/replay
